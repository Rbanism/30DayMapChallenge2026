#MAKING THE MAP
# Getting the cycle network of Rotterdam
cyclestreets <- opq("Rotterdam, Netherlands") |>
add_osm_feature(key = "highway",
value = c("cycleway", "path", "residential", "living street"))|>
osmdata_sf()
> ls()
